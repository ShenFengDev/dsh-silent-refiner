{
  "name": "dsh-prompt-optimizer-shenfeng",
  "version": "1.0.0",
  "description": "Optimize a prompt with the model currently selected in the conversation and show the result in the right sidebar.",
  "type": "module",
  "main": "./lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/host.js",
    "lib/prompts.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "dsh": ">=0.2.3-alpha.2"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "prompt-optimizer",
    "prompt-engineering"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShenFengDev/dsh-prompt-optimizer.git"
  },
  "homepage": "https://github.com/ShenFengDev/dsh-prompt-optimizer#readme",
  "bugs": {
    "url": "https://github.com/ShenFengDev/dsh-prompt-optimizer/issues"
  },
  "author": "ShenFengDev",
  "license": "MIT"
}
